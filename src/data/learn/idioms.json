[
  { "id": "idiom-001", "type": "phrase", "category": "idioms", "en": "No problem. / No worries.", "zh": "沒問題、別擔心", "note": "回應道謝或道歉都很好用。", "audio": "/audio/learn/idioms/idiom-001.mp3", "examples": [ { "en": "No worries, take your time.", "zh": "別擔心，你慢慢來。", "audio": "/audio/learn/idioms/idiom-001-e1.mp3" } ] },
  { "id": "idiom-002", "type": "phrase", "category": "idioms", "en": "Excuse me.", "zh": "不好意思（引起注意或借過）", "note": "叫住別人、借過、打斷時都用它。", "audio": "/audio/learn/idioms/idiom-002.mp3", "examples": [ { "en": "Excuse me, could you help me?", "zh": "不好意思，可以幫我嗎？", "audio": "/audio/learn/idioms/idiom-002-e1.mp3" } ] },
  { "id": "idiom-003", "type": "phrase", "category": "idioms", "en": "Never mind.", "zh": "沒關係、算了", "note": "對方幫不上或你改變主意時。", "audio": "/audio/learn/idioms/idiom-003.mp3", "examples": [ { "en": "Never mind, I'll ask someone else.", "zh": "沒關係，我再問別人。", "audio": "/audio/learn/idioms/idiom-003-e1.mp3" } ] },
  { "id": "idiom-004", "type": "phrase", "category": "idioms", "en": "Here you go.", "zh": "（遞東西時）給你", "note": "把東西交給對方時說，等同 Here you are.", "audio": "/audio/learn/idioms/idiom-004.mp3", "examples": [ { "en": "Here you go, that's your receipt.", "zh": "給你，這是你的收據。", "audio": "/audio/learn/idioms/idiom-004-e1.mp3" } ] },
  { "id": "idiom-005", "type": "phrase", "category": "idioms", "en": "Go ahead.", "zh": "請便、你先（請對方先做）", "audio": "/audio/learn/idioms/idiom-005.mp3", "examples": [ { "en": "Go ahead, I'll wait.", "zh": "你先，我等一下。", "audio": "/audio/learn/idioms/idiom-005-e1.mp3" } ] },
  { "id": "idiom-006", "type": "phrase", "category": "idioms", "en": "After you.", "zh": "您先請", "note": "讓對方先進門、先走時的禮貌說法。", "audio": "/audio/learn/idioms/idiom-006.mp3", "examples": [ { "en": "After you, please.", "zh": "您先請。", "audio": "/audio/learn/idioms/idiom-006-e1.mp3" } ] },
  { "id": "idiom-007", "type": "phrase", "category": "idioms", "en": "Take your time.", "zh": "慢慢來、不急", "audio": "/audio/learn/idioms/idiom-007.mp3", "examples": [ { "en": "Take your time, there's no rush.", "zh": "慢慢來，不急。", "audio": "/audio/learn/idioms/idiom-007-e1.mp3" } ] },
  { "id": "idiom-008", "type": "phrase", "category": "idioms", "en": "No rush.", "zh": "不急、不趕時間", "audio": "/audio/learn/idioms/idiom-008.mp3", "examples": [ { "en": "No rush, whenever you're ready.", "zh": "不急，你準備好就行。", "audio": "/audio/learn/idioms/idiom-008-e1.mp3" } ] },
  { "id": "idiom-009", "type": "phrase", "category": "idioms", "en": "Sounds good.", "zh": "聽起來不錯、好啊", "note": "表示同意對方的提議。", "audio": "/audio/learn/idioms/idiom-009.mp3", "examples": [ { "en": "Sounds good, let's do that.", "zh": "好啊，就這麼辦。", "audio": "/audio/learn/idioms/idiom-009-e1.mp3" } ] },
  { "id": "idiom-010", "type": "phrase", "category": "idioms", "en": "That works for me.", "zh": "那樣可以、我OK", "audio": "/audio/learn/idioms/idiom-010.mp3", "examples": [ { "en": "Three o'clock? That works for me.", "zh": "三點嗎？我可以。", "audio": "/audio/learn/idioms/idiom-010-e1.mp3" } ] },
  { "id": "idiom-011", "type": "phrase", "category": "idioms", "en": "It's up to you.", "zh": "你決定就好", "audio": "/audio/learn/idioms/idiom-011.mp3", "examples": [ { "en": "Where to eat? It's up to you.", "zh": "去哪吃？你決定就好。", "audio": "/audio/learn/idioms/idiom-011-e1.mp3" } ] },
  { "id": "idiom-012", "type": "phrase", "category": "idioms", "en": "Just looking, thanks.", "zh": "只是看看，謝謝", "note": "店員上前招呼、你還不想買時的標準回應。", "audio": "/audio/learn/idioms/idiom-012.mp3", "examples": [ { "en": "I'm just looking, thanks.", "zh": "我只是看看，謝謝。", "audio": "/audio/learn/idioms/idiom-012-e1.mp3" } ] },
  { "id": "idiom-013", "type": "phrase", "category": "idioms", "en": "Maybe later.", "zh": "也許待會、改天吧", "note": "委婉婉拒或延後。", "audio": "/audio/learn/idioms/idiom-013.mp3", "examples": [ { "en": "Maybe later, thanks.", "zh": "也許等一下，謝謝。", "audio": "/audio/learn/idioms/idiom-013-e1.mp3" } ] },
  { "id": "idiom-014", "type": "phrase", "category": "idioms", "en": "I'm not sure.", "zh": "我不確定", "audio": "/audio/learn/idioms/idiom-014.mp3", "examples": [ { "en": "I'm not sure, let me check.", "zh": "我不確定，我查一下。", "audio": "/audio/learn/idioms/idiom-014-e1.mp3" } ] },
  { "id": "idiom-015", "type": "phrase", "category": "idioms", "en": "Let me see.", "zh": "我看看、讓我想想", "audio": "/audio/learn/idioms/idiom-015.mp3", "examples": [ { "en": "Let me see... yes, that's fine.", "zh": "我看看……嗯，可以。", "audio": "/audio/learn/idioms/idiom-015-e1.mp3" } ] },
  { "id": "idiom-016", "type": "phrase", "category": "idioms", "en": "Got it.", "zh": "懂了、了解", "note": "聽懂了、收到了的口語回應。", "audio": "/audio/learn/idioms/idiom-016.mp3", "examples": [ { "en": "Got it, thank you.", "zh": "了解，謝謝。", "audio": "/audio/learn/idioms/idiom-016-e1.mp3" } ] },
  { "id": "idiom-017", "type": "phrase", "category": "idioms", "en": "My bad.", "zh": "我的錯（輕鬆道歉）", "note": "口語、朋友間的道歉；正式場合用 I'm sorry.", "audio": "/audio/learn/idioms/idiom-017.mp3", "examples": [ { "en": "Oh, my bad. Sorry about that.", "zh": "喔，我的錯，抱歉。", "audio": "/audio/learn/idioms/idiom-017-e1.mp3" } ] },
  { "id": "idiom-018", "type": "phrase", "category": "idioms", "en": "Fair enough.", "zh": "有道理、可以接受", "note": "接受對方的說法或理由。", "audio": "/audio/learn/idioms/idiom-018.mp3", "examples": [ { "en": "Fair enough, I'll take it.", "zh": "有道理，那我買了。", "audio": "/audio/learn/idioms/idiom-018-e1.mp3" } ] },
  { "id": "idiom-019", "type": "phrase", "category": "idioms", "en": "You're all set.", "zh": "（對方說）您都辦好了", "note": "店員/櫃台常用，表示手續完成。", "audio": "/audio/learn/idioms/idiom-019.mp3", "examples": [ { "en": "You're all set. Enjoy your stay.", "zh": "都辦好了，祝您住得愉快。", "audio": "/audio/learn/idioms/idiom-019-e1.mp3" } ] },
  { "id": "idiom-020", "type": "phrase", "category": "idioms", "en": "Take care.", "zh": "保重（道別）", "audio": "/audio/learn/idioms/idiom-020.mp3", "examples": [ { "en": "Bye, take care!", "zh": "再見，保重！", "audio": "/audio/learn/idioms/idiom-020-e1.mp3" } ] },
  { "id": "idiom-021", "type": "phrase", "category": "idioms", "en": "Have a good one.", "zh": "祝你順心（輕鬆的道別）", "note": "等同 Have a nice day，更口語。", "audio": "/audio/learn/idioms/idiom-021.mp3", "examples": [ { "en": "Thanks, have a good one!", "zh": "謝啦，祝你順心！", "audio": "/audio/learn/idioms/idiom-021-e1.mp3" } ] },
  { "id": "idiom-022", "type": "phrase", "category": "idioms", "en": "Bless you.", "zh": "（對方打噴嚏時）保重", "note": "聽到別人打噴嚏時的禮貌反應。", "audio": "/audio/learn/idioms/idiom-022.mp3", "examples": [ { "en": "Bless you! Are you okay?", "zh": "保重！你還好嗎？", "audio": "/audio/learn/idioms/idiom-022-e1.mp3" } ] }
]
